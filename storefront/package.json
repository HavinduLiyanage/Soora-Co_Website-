{
  "name": "soora-storefront",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node node_modules/next/dist/bin/next dev --hostname 127.0.0.1",
    "build": "node node_modules/next/dist/bin/next build",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/catalog.test.ts",
    "images": "node scripts/prepare-images.mjs",
    "build:server": "node scripts/build-server.mjs"
  },
  "dependencies": {
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "lucide-react": "1.66.0",
    "@fontsource-variable/manrope": "5.3.0"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "sharp": "0.35.5"
  },
  "type": "module"
}
