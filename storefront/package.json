{
  "name": "soora-storefront",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node node_modules/next/dist/bin/next dev --hostname 127.0.0.1",
    "build": "node node_modules/next/dist/bin/next build",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/catalog.test.ts tests/admin.test.ts",
    "images": "node scripts/prepare-images.mjs",
    "build:server": "node scripts/build-server.mjs",
    "db:setup": "node --env-file=.env.local scripts/setup-db.mjs",
    "owner:create": "node --env-file=.env.local --env-file=.env.owner scripts/create-owner.mjs",
    "start": "node node_modules/next/dist/bin/next start --hostname 127.0.0.1"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "5.3.0",
    "@vercel/blob": "2.8.2",
    "better-auth": "1.7.14",
    "lucide-react": "1.66.0",
    "next": "16.4.3",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.13",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2"
  },
  "type": "module"
}
